# Copy this file to `.env` and adjust the values for your environment.
#
# The file is registered as a Flutter asset in pubspec.yaml, so the exact
# path must match. Values are public client-side configuration only — do not
# store secrets here.

# Base URL of the Planles backend (must include the /api prefix).
API_BASE_URL=https://api.planles.nl/api

# Optional: override URLs for the dev/staging switcher on the login page.
# API_BASE_URL_STAGING=https://staging.planles.nl/api
# API_BASE_URL_DEV=http://localhost:8000/api

# Optional: VAPID key for web push (Firebase Console → Cloud Messaging → Web Push certificates).
# FCM_VAPID_KEY=your_vapid_key_here
